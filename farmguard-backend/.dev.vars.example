# Local development secrets for `wrangler dev` / vitest.
# Copy to `.dev.vars` and fill in real values. NEVER commit `.dev.vars`.
#
# Remote deployments use Wrangler secrets instead:
#   npx wrangler secret put AUTH_SECRET
#   npx wrangler secret put FCM_SERVICE_ACCOUNT < service-account.json

# HMAC signing key for farmer (12 h) and camera (30 d) bearer tokens.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"

# Firebase service-account JSON (single line). Optional: when absent the
# backend still works, it just skips push delivery ("FCM not configured").
# FCM_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
